-- One reaction per person per message (1:1 chats: me or the peer).
-- An empty emoji with pending = 1 is a removal that still has to be sent.
CREATE TABLE reaction (
    message_id TEXT NOT NULL,
    from_self INTEGER NOT NULL,
    emoji TEXT NOT NULL,
    pending INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (message_id, from_self)
);

CREATE INDEX reaction_pending ON reaction(pending) WHERE pending = 1;

forPeer:
SELECT r.* FROM reaction r JOIN message m ON m.id = r.message_id
WHERE m.peer_fp = ? AND r.emoji != '';

upsert:
INSERT OR REPLACE INTO reaction(message_id, from_self, emoji, pending) VALUES (?, ?, ?, ?);

pendingForPeer:
SELECT r.* FROM reaction r JOIN message m ON m.id = r.message_id
WHERE m.peer_fp = ? AND r.pending = 1 AND r.from_self = 1;

markSent:
UPDATE reaction SET pending = 0 WHERE message_id = ? AND from_self = 1 AND emoji = ?;

deleteOne:
DELETE FROM reaction WHERE message_id = ? AND from_self = ?;

deleteForMessage:
DELETE FROM reaction WHERE message_id = ?;

deleteForPeer:
DELETE FROM reaction WHERE message_id IN (SELECT id FROM message WHERE peer_fp = ?);
