CREATE TABLE contact (
    fingerprint TEXT NOT NULL PRIMARY KEY,
    public_key BLOB NOT NULL,
    display_name TEXT NOT NULL,
    role TEXT NOT NULL DEFAULT '',
    verified INTEGER NOT NULL DEFAULT 0,
    favorite INTEGER NOT NULL DEFAULT 0,
    blocked INTEGER NOT NULL DEFAULT 0,
    last_host TEXT,
    last_port INTEGER,
    last_seen_ms INTEGER,
    created_at_ms INTEGER NOT NULL,
    allow_ptt INTEGER NOT NULL DEFAULT 0,
    linked INTEGER NOT NULL DEFAULT 0,
    allow_intercom INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM contact ORDER BY favorite DESC, display_name COLLATE NOCASE;

selectByFingerprint:
SELECT * FROM contact WHERE fingerprint = ?;

insert:
INSERT OR IGNORE INTO contact(fingerprint, public_key, display_name, role, verified, favorite, blocked, last_host, last_port, last_seen_ms, created_at_ms)
VALUES (?, ?, ?, ?, ?, 0, 0, ?, ?, ?, ?);

updateProfile:
UPDATE contact SET display_name = ?, role = ? WHERE fingerprint = ?;

updateSeen:
UPDATE contact SET last_host = ?, last_port = ?, last_seen_ms = ? WHERE fingerprint = ?;

setVerified:
UPDATE contact SET verified = ? WHERE fingerprint = ?;

setFavorite:
UPDATE contact SET favorite = ? WHERE fingerprint = ?;

setBlocked:
UPDATE contact SET blocked = ? WHERE fingerprint = ?;

setAllowPtt:
UPDATE contact SET allow_ptt = ? WHERE fingerprint = ?;

setLinked:
UPDATE contact SET linked = ? WHERE fingerprint = ?;

setAllowIntercom:
UPDATE contact SET allow_intercom = ? WHERE fingerprint = ?;

delete:
DELETE FROM contact WHERE fingerprint = ?;
